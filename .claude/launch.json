{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cosec-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "url": "http://127.0.0.1:3000"
    },
    {
      "name": "cosec-prod",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "npm run build && npm start"
      ],
      "port": 3000,
      "url": "http://127.0.0.1:3000"
    }
  ]
}